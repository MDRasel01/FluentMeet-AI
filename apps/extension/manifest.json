{
  "manifest_version": 3,
  "name": "FluentMeet AI — Real-time English Meeting Coach",
  "version": "1.0.0",
  "description": "Real-time speech coaching, grammar feedback, and speaking metrics for Google Meet, Zoom, and MS Teams.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "tabCapture",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "http://localhost:8000/*",
    "ws://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Open FluentMeet AI Coach"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/offscreen/audio-worklet/pcm-processor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
