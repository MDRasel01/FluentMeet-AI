# ==============================================================================
# FluentMeet AI — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_NAME=FluentMeet AI
DEBUG=true
LOG_LEVEL=INFO

# Backend API Service
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://*"]

# Frontend & Extension Connectivity
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Database (PostgreSQL with asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_coach
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache & Worker Message Broker
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT + Password Hashing)
JWT_SECRET_KEY=change_me_to_a_secure_random_64_character_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoring & Error Reporting (Sentry)
SENTRY_DSN=

# Future AI Integrations (Reserved for Steps 07-09)
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

